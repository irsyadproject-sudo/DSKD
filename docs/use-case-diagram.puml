@startuml DPMS_UseCase_Diagram
left to right direction
skinparam packageStyle rectangle
skinparam actorStyle awesome
skinparam usecase {
  BackgroundColor #F4F6F9
  BorderColor #5e72e4
  ArrowColor #344767
  FontSize 13
}
skinparam actor {
  BackgroundColor #5e72e4
  BorderColor #3b5998
  FontColor #344767
  FontSize 14
}
skinparam package {
  BackgroundColor #FFFFFF
  BorderColor #e9ecef
  FontSize 15
  FontStyle bold
}
skinparam note {
  BackgroundColor #fff4e5
  BorderColor #ff9f43
}

title Use Case Diagram — DPMS (Digital Project Management System)

actor "Super Admin" as SA
actor "Project Manager" as PM
actor "Team Member" as TM
actor "Client" as C

rectangle "Authentication" {
  usecase "Login" as UC_Login
  usecase "Register (Client)" as UC_Register
  usecase "Logout" as UC_Logout
}

rectangle "Dashboard" {
  usecase "Lihat Dashboard\n(Statistik & Chart)" as UC_Dashboard
}

rectangle "Manajemen User" {
  usecase "Lihat Daftar User" as UC_ListUser
  usecase "Tambah User" as UC_AddUser
  usecase "Edit User" as UC_EditUser
  usecase "Hapus User" as UC_DelUser
}

rectangle "Manajemen Client" {
  usecase "Lihat Daftar Client" as UC_ListClient
  usecase "Tambah Client" as UC_AddClient
  usecase "Edit Client" as UC_EditClient
  usecase "Hapus Client" as UC_DelClient
  usecase "Lihat Detail Client" as UC_ShowClient
}

rectangle "Manajemen Proyek" {
  usecase "Lihat Daftar Proyek" as UC_ListProject
  usecase "Buat Proyek" as UC_AddProject
  usecase "Lihat Detail Proyek" as UC_ShowProject
  usecase "Edit Proyek" as UC_EditProject
  usecase "Hapus Proyek" as UC_DelProject
  usecase "Ubah Status Proyek" as UC_ChgStatusProject
  usecase "Tambah Anggota Tim" as UC_AddMember
  usecase "Hapus Anggota Tim" as UC_DelMember
}

rectangle "Manajemen Task" {
  usecase "Lihat Daftar Task" as UC_ListTask
  usecase "Buat Task" as UC_AddTask
  usecase "Lihat Detail Task" as UC_ShowTask
  usecase "Edit Task" as UC_EditTask
  usecase "Hapus Task" as UC_DelTask
  usecase "Update Progress Task" as UC_ProgressTask
}

rectangle "Kanban Board" {
  usecase "Pilih Proyek\nKanban" as UC_KanbanIdx
  usecase "Lihat Board\n(Drag & Drop)" as UC_KanbanShow
  usecase "Pindahkan Task\nantar Kolom" as UC_KanbanMove
}

rectangle "File & Lampiran" {
  usecase "Upload File" as UC_Upload
  usecase "Download File" as UC_Download
  usecase "Hapus File" as UC_DelFile
}

rectangle "Komentar" {
  usecase "Tambah Komentar" as UC_AddComment
  usecase "Hapus Komentar" as UC_DelComment
}

rectangle "Revisi" {
  usecase "Ajukan Revisi" as UC_SubmitRevision
  usecase "Lihat Daftar Revisi" as UC_ListRevision
  usecase "Ubah Status Revisi" as UC_ChgRevisionStatus
}

rectangle "Persetujuan" {
  usecase "Setujui Task\n(Approve)" as UC_Approve
}

rectangle "Laporan" {
  usecase "Lihat Laporan" as UC_Report
  usecase "Export CSV" as UC_ExportCSV
  usecase "Export PDF" as UC_ExportPDF
}

rectangle "Notifikasi" {
  usecase "Tandai Sudah Dibaca" as UC_NotifRead
  usecase "Tandai Semua\nDibaca" as UC_NotifReadAll
  usecase "Hapus Notifikasi" as UC_DelNotif
}

rectangle "Profil" {
  usecase "Lihat Profil" as UC_ShowProfile
  usecase "Edit Profil" as UC_EditProfile
}

